// Reference only — these objects were created through the UI/MCP (JSONDB-managed). Do NOT drop this file into
// conf/items next to them (duplicates). Use it to recreate the model on another install.
// Channel UIDs: replace with your own icalendar:calendar:<id> Things (one per bin).

Group gWastePickups "Waste Pickups"

Group:DateTime:EARLIEST Waste_Paper_Pickup   "Paper Waste"   (gWastePickups) { binColor="#2563eb" }
Group:DateTime:EARLIEST Waste_Organic_Pickup "Organic Waste" (gWastePickups) { binColor="#0f766e" }
Group:DateTime:EARLIEST Waste_Plastic_Pickup "Plastic Waste" (gWastePickups) { binColor="#a16207" }
Group:DateTime:EARLIEST Waste_General_Pickup "General Waste" (gWastePickups) { binColor="#4b5563" }

// effective "current" pickup (UNDEF when no event is running)
DateTime Waste_Paper_CurrentStart   "Paper Waste Current Pickup Start"   (Waste_Paper_Pickup)   { channel="icalendar:calendar:1051001e85:current_start" }
DateTime Waste_Organic_CurrentStart "Organic Waste Current Pickup Start" (Waste_Organic_Pickup) { channel="icalendar:calendar:36ff9a7611:current_start" }
DateTime Waste_Plastic_CurrentStart "Plastic Waste Current Pickup Start" (Waste_Plastic_Pickup) { channel="icalendar:calendar:9823821b25:current_start" }
DateTime Waste_General_CurrentStart "General Waste Current Pickup Start" (Waste_General_Pickup) { channel="icalendar:calendar:bbb66545af:current_start" }

// existing "next pickup" items get an extra group membership (they keep their other groups/links):
//   Paper_Tonne_Result_0_Begin                    -> Waste_Paper_Pickup    (channel ...:1051001e85:next_start)
//   Calendar_Waste_Events_Organic_Result_0_Begin  -> Waste_Organic_Pickup  (channel ...:36ff9a7611:next_start)
//   Gelber_Sack_Result_0_Begin                    -> Waste_Plastic_Pickup  (channel ...:9823821b25:next_start)
//   Hausabfall_Result_0_Begin                     -> Waste_General_Pickup  (channel ...:bbb66545af:next_start)
